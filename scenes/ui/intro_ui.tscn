[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/intro_ui.gd" id="1_intro_ui"]

[node name="UI" type="CanvasLayer"]
script = ExtResource("1_intro_ui")

[node name="HintMargin" type="MarginContainer" parent="."]
offset_left = 24.0
offset_top = 24.0
offset_right = 500.0
offset_bottom = 100.0
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="HintBackground" type="ColorRect" parent="HintMargin"]
layout_mode = 2
color = Color(0, 0, 0, 0.72)
mouse_filter = 2

[node name="InteractionHint" type="Label" parent="HintMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 18
text = ""
vertical_alignment = 1

[node name="BallotPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -190.0
offset_right = 230.0
offset_bottom = 190.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="BallotPanel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="BallotPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="BallotPanel/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Бюллетень"
horizontal_alignment = 1

[node name="Instruction" type="Label" parent="BallotPanel/Margin/Column"]
layout_mode = 2
text = "Выберите одну партию и подтвердите выбор."
horizontal_alignment = 1
autowrap_mode = 2

[node name="PartyList" type="VBoxContainer" parent="BallotPanel/Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="ConfirmButton" type="Button" parent="BallotPanel/Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Подтвердить выбор"

[node name="CompletionPanel" type="PanelContainer" parent="."]
unique_name_in_owner = true
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -100.0
offset_right = 230.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="CompletionPanel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Message" type="Label" parent="CompletionPanel/Margin"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Голос принят. Вступление завершено."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="BallotPanel/Margin/Column/ConfirmButton" to="." method="_on_confirm_button_pressed"]
