[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_main_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main_menu")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuColumn" type="VBoxContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="CenterContainer/MenuColumn"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Жизнь в России"
horizontal_alignment = 1

[node name="Buttons" type="VBoxContainer" parent="CenterContainer/MenuColumn"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NewGameButton" type="Button" parent="CenterContainer/MenuColumn/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Новая игра"

[node name="ExitButton" type="Button" parent="CenterContainer/MenuColumn/Buttons"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "Выход"

[node name="StatusLabel" type="Label" parent="CenterContainer/MenuColumn"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Статус"
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="CenterContainer/MenuColumn/Buttons/NewGameButton" to="." method="_on_new_game_button_pressed"]
[connection signal="pressed" from="CenterContainer/MenuColumn/Buttons/ExitButton" to="." method="_on_exit_button_pressed"]
